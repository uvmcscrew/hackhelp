# --- Discord Bot ---
# Bot token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=
# Application ID from the Discord Developer Portal (General Information)
DISCORD_APPLICATION_ID=
# The single guild (server) this bot serves. Commands are deployed to this
# guild and register instantly. Enable Developer Mode in Discord, then
# right-click the server name > Copy Server ID.
DISCORD_GUILD_ID=

# --- Postgres Database Connection URL ---
# The provided example corresponds to the docker compose database
DATABASE_URL=postgres://cscrew:database@localhost:32700/hackhelp
