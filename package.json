{
	"name": "hackhelp-root",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"db:start": "docker compose up",
		"auth:generate": "bun run --cwd packages/auth auth:generate",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@types/bun": "^1.4.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"railway": "^3.16.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1"
	},
	"dependencies": {
		"@eslint/js": "10.0.1",
		"globals": "17.13.0"
	}
}
